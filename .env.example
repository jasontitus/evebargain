# EVE Online SSO Application Credentials
# Register at https://developers.eveonline.com/
EVE_CLIENT_ID=your_client_id_here
EVE_SECRET_KEY=your_secret_key_here
EVE_CALLBACK_URL=http://localhost:8000/api/auth/callback

# Application Settings
# Where your browser reaches the UI. SSO sends you back here after login.
# Use http://localhost:3000 when running under Docker.
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./evebargain.db
SESSION_SECRET=change-this-to-a-random-secret-key

# Optional: Override defaults
# LOCATION_POLL_INTERVAL=30
# MARKET_UPDATE_INTERVAL=300
# DEFAULT_DISCOUNT_THRESHOLD=0.10
